.local	B_PMG						; UNIT

.local	PMG_INIT					; PROCEDURE | OVERLOAD
.local	@03018000001800000180000

; optimize OK (B_PMG), line = 171

	lda BASE
	sta PMG_PMBASE

; optimize OK (B_PMG), line = 172

	lda #$00
	sta PMG_BASE
	lda BASE
	sta PMG_BASE+1

; optimize OK (B_PMG), line = 173

	lda GRACTL
	sta PMG_GRACTL

; optimize OK (B_PMG), line = 174

	lda PMG_SDMCTL_S
	and #$E0
	ora SDMCTL
	sta SDMCTL_FLAGS

; optimize OK (B_PMG), line = 175

	sta PMG_SDMCTL

; optimize OK (B_PMG), line = 176

